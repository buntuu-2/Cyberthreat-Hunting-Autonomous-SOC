# AI Cyberthreat Hunting & Autonomous SOC Configuration

# Environment mode: development / testing / production
ENV_MODE=development

# Threat Intelligence APIs (Optional - offline mock mode is enabled by default if keys are blank)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
MOCK_THREAT_INTEL=True

# AI Analysis Configuration
# LLM Providers: "mock" (offline rule-based SOC AI), "gemini", "openai", "ollama"
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Autonomous Response Configuration
AUTO_RESPONSE_ENABLED=True
MIN_SEVERITY_AUTO_BLOCK=HIGH
DEFAULT_BLOCK_TTL_SECONDS=300
ALLOWLISTED_IPS=127.0.0.1,::1,192.168.1.1,10.0.0.1

# Firewall Execution Mode: "simulation" (safe lab demo) or "ufw" (requires sudo ufw)
FIREWALL_MODE=simulation

# Web Dashboard Server
HOST=0.0.0.0
PORT=8000
